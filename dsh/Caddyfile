{
	admin off
}

:3080 {
	basic_auth {
		{env.DSH_UI_USERNAME} {env.DSH_UI_PASSHASH}
	}
	reverse_proxy 127.0.0.1:3081 {
		# dsh issues its own per-start session cookie; entrypoint.sh obtains it
		# once and Caddy presents it on every request, so users only see the
		# basic-auth login.
		header_up Cookie "{file./run/dsh/cookie}"
	}
}
